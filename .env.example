# ── Required ──────────────────────────────────────────────
# Your Anthropic API key (rotate the one you shared earlier!)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Recommended ───────────────────────────────────────────
# Where WhatsApp login is stored. On Railway, attach a Volume
# mounted at /data and set this to /data/auth so you scan the
# QR ONCE and stay logged in across redeploys.
AUTH_DIR=/data/auth

# The booking link the bot shares to close the sale.
CALENDLY_URL=https://calendly.com/thebrothing/dating-consultation-session

# ── Optional ──────────────────────────────────────────────
# Model (default is the cheapest vision-capable Haiku).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Protect the /qr page so only you can open it. If set, open
# the QR at:  https://your-app.up.railway.app/qr?t=YOUR_TOKEN
QR_ACCESS_TOKEN=

# HTTP port (Railway sets PORT automatically — leave blank there).
PORT=3000

# Reply "typing" delay window in milliseconds (feels human).
MIN_REPLY_DELAY_MS=1200
MAX_REPLY_DELAY_MS=2600

# Optional: log every WhatsApp chat into the same Supabase the
# dashboard reads (chat_sessions / chat_messages tables).
SUPABASE_URL=
SUPABASE_ANON_KEY=
